# Google Cloud OAuth client ids. Expo only inlines EXPO_PUBLIC_ names.
# A bare GOOGLE_CLIENT_ID in the shell is invisible to the app.
# The web client id used by this project lives in .env (public client id, not a secret).

# Web client. Redirects registered in Google Cloud (exact match, no /giris path):
#   https://auth.expo.io/@anonymous/bu-gece
#   http://localhost:8081
#   https://localhost
#   http://localhost
#   http://127.0.0.1
#   https://127.0.0.1
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# iOS client. Bundle id com.bugece.app. Also add the reversed client id URL scheme
# com.googleusercontent.apps.<ios-id-without-.apps.googleusercontent.com>
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Android client. Package com.bugece.app plus the release SHA-1.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Optional https redirect for Expo Go when makeRedirectUri returns exp://
# Example: https://auth.expo.io/@owner/bu-gece/giris
# EXPO_PUBLIC_GOOGLE_REDIRECT_URI=

# Firebase web app on project bu-gece (client config). Firestore: production, europe-west1.
# Empty or your-* values fall back to this same web app inside src/lib/firebaseApp.ts.
# Genel uses MEMBERS seeds when the listener fails or nobody is online.
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyBdQN11BwwxNVFImZiK7cz-iltcH73Vtqg
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=bu-gece.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=bu-gece
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=bu-gece.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=746154431428
EXPO_PUBLIC_FIREBASE_APP_ID=1:746154431428:web:0ba9a25181417a76414a91
# EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
