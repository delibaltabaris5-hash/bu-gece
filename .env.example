# Google Cloud OAuth client ids. Leave blank until they are filled.
# Expo only inlines names that start with EXPO_PUBLIC_. A bare GOOGLE_CLIENT_ID
# in the shell is invisible to the app. Do not commit real client ids.
# "Gmail ile devam et" calls Google.useAuthRequest once the id for this platform is set.

# Web client id (this is the web GOOGLE_CLIENT_ID). Either name works.
# Authorized JavaScript origin and redirect: Linking.createURL('giris', { scheme: 'bugece' }).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# iOS client id. Bundle id: com.bugece.app
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Android client id. Package: com.bugece.app, plus the app signing SHA-1.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
