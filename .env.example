# Google Cloud OAuth client ids. Leave blank until they are filled.
# The white "Gmail ile devam et" pill calls expo-auth-session only after the
# id for the current platform is set. Do not commit real client ids.

# Web client. Authorized JavaScript origin and redirect: the site origin
# produced by Linking.createURL('giris', { scheme: 'bugece' }).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# iOS client. Bundle id: com.bugece.app
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Android client. Package: com.bugece.app, plus the app signing SHA-1.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
