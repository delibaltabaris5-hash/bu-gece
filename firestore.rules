rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profiles live in users/{uid}. Auth is Firebase Auth. Local storage is session only.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.createdAt is number;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Presence stays open for the live room list. Account identity is users/{uid}.
    match /presence/{userId} {
      allow read, write: if true;
    }

    // MVP: live DMs between two accounts. Same open access as presence.
    // TODO(auth): require request.auth before production. Thread ids are email pairs.
    match /dmThreads/{threadId}/messages/{messageId} {
      allow read, write: if true;
    }

    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 3;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.type == 'text'
          && (
            (request.resource.data.senderType == 'user' && request.resource.data.senderId == request.auth.uid)
            || (request.resource.data.senderType == 'bot' && request.resource.data.senderId.matches('bot-.*'))
          );
        allow update, delete: if false;
      }
    }
  }
}
