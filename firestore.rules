rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profiles live in users/{uid}. Auth is Firebase Auth. Local storage is session only.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.createdAt is number;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Presence stays open for the live room list. Account identity is users/{uid}.
    match /presence/{userId} {
      allow read, write: if true;
    }

    // MVP: live DMs between two accounts. Same open access as presence.
    // TODO(auth): require request.auth before production. Thread ids are email pairs.
    match /dmThreads/{threadId}/messages/{messageId} {
      allow read, write: if true;
    }
  }
}
