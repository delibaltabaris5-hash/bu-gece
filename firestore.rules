rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profiles live in users/{uid}. Auth is Firebase Auth. Local storage is session only.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.createdAt is number;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && (
          (
            request.resource.data.get('matchedWith', null) == resource.data.get('matchedWith', null)
            && request.resource.data.get('matchId', null) == resource.data.get('matchId', null)
            && (
              request.resource.data.get('matchStatus', null) == resource.data.get('matchStatus', null)
              || (
                request.resource.data.matchStatus in ['idle', 'waiting']
                && resource.data.get('matchStatus', 'idle') != 'matched'
              )
            )
          )
          || (
            request.resource.data.matchStatus == 'matched'
            && resource.data.get('matchStatus', 'idle') == 'waiting'
            && request.resource.data.matchId is string
            && exists(/databases/$(database)/documents/matches/$(request.resource.data.matchId))
            && request.auth.uid in get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.users
            && request.resource.data.matchedWith in get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.users
            && request.resource.data.matchedWith != request.auth.uid
            && get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.mood == request.resource.data.mood
          )
        );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Presence stays open for the live room list. Account identity is users/{uid}.
    match /matchQueue/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.mood is string;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /matchSlot/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.mood is string
        && request.resource.data.status == 'waiting'
        && (request.resource.data.claim == '' || request.resource.data.claim is string);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    function queueWaiting(uid, mood) {
      let q = get(/databases/$(database)/documents/matchQueue/$(uid)).data;
      let s = get(/databases/$(database)/documents/matchSlot/$(uid)).data;
      return q.uid == uid
        && q.status == 'waiting'
        && q.mood == mood
        && s.uid == uid
        && s.status == 'waiting'
        && s.mood == mood;
    }

    function claimsEachOther(a, b) {
      return get(/databases/$(database)/documents/matchSlot/$(a)).data.claim == b
        && get(/databases/$(database)/documents/matchSlot/$(b)).data.claim == a;
    }

    match /matches/{matchId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && request.resource.data.status == 'active'
        && request.resource.data.mood is string
        && queueWaiting(request.resource.data.users[0], request.resource.data.mood)
        && queueWaiting(request.resource.data.users[1], request.resource.data.mood)
        && claimsEachOther(request.resource.data.users[0], request.resource.data.users[1])
        && request.resource.data.chatId is string;
      allow update, delete: if false;
    }

    match /presence/{userId} {
      allow read, write: if true;
    }

    // MVP: live DMs between two accounts. Same open access as presence.
    // TODO(auth): require request.auth before production. Thread ids are email pairs.
    match /dmThreads/{threadId}/messages/{messageId} {
      allow read, write: if true;
    }

    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 3;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.type == 'text'
          && (
            (request.resource.data.senderType == 'user' && request.resource.data.senderId == request.auth.uid)
            || (request.resource.data.senderType == 'bot' && request.resource.data.senderId.matches('bot-.*'))
          );
        allow update, delete: if false;
      }
    }
  }
}
