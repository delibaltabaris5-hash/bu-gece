rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Published MVP for project bu-gece (Firestore production, europe-west1).
    // TODO(auth): accounts live in SecureStore, so this is not bound to request.auth.
    // Risk: presence/{userId} is world-readable and world-writable. The id is the
    // account email. Lock writes to request.auth.uid == userId before production.
    match /presence/{userId} {
      allow read, write: if true;
    }

    // MVP: live DMs between two accounts. Same open access as presence.
    // TODO(auth): require request.auth before production. Thread ids are email pairs.
    match /dmThreads/{threadId}/messages/{messageId} {
      allow read, write: if true;
    }
  }
}
